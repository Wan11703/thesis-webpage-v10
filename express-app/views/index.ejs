<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MedExtract</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/index.css" />
</head>

<body>
  <nav class="guest-navbar">
    <div class="container">
      <div class="logo">
        <h1><a href="/">MedExtract</a></h1>
      </div>

      <div class="menu-toggle" id="menu-toggle">&#9776;</div> <!-- Burger icon -->

      <ul class="nav" id="guest-nav">
        <li><a href="/">Home</a></li>
        <li><a href="/html/guest/guest-about.html">About</a></li>
        <li><a href="/guest-login">Login</a></li>
        <li><a href="/guest-register">Register</a></li>
      </ul>

    </div>
  </nav>

  <header class="header">
    <div class="container">
      <div class="header-txt">
        <h1>MedExtract</h1>
        <p>
          MedExtract transforms clinical prescriptions into actionable insights using intelligent text analysis. 
        Through advanced preprocessing and BioBERT-based drug identification, the system retrieves accurate 
        pharmaceutical information from DrugBank—empowering healthcare professionals with reliable and timely data.
        </p>
        <div class="button">
          <button>
            <a href="/user-search">
              <h3>Get Started</h3>
            </a>
          </button>
        </div>
      </div>
      <img class="header-img" src="/images/index-img.jpg" />
    </div>
  </header>

  <section class="boxes">
    <div class="container">
      <h1>FEATURES</h1>
      <div class="box-container">
        <div class="box">
          <h2>OCR Scanning</h2>
          <img src="/flaticons/index/ocr.png" />
          <p>
            Our system begins by scanning and preprocessing clinical prescriptions through Optical Character Recognition (OCR). 
    This step ensures that handwritten or printed medical content is converted into accurate, machine-readable text for analysis.
          </p>
        </div>

        <div class="box">
          <h2>Machine Learning</h2>
          <img src="/flaticons/index/coding.png" />
          <p>
            Using a BioBERT-based named entity recognition model, the system identifies drug names and related entities from the text. 
    This machine learning process ensures high precision in extracting structured data from clinical narratives.
          </p>
        </div>

        <div class="box">
          <h2>Medical Insights</h2>
          <img src="/flaticons/index/documents.png" />
          <p>
            Once drug names are identified, our system retrieves relevant medical information from DrugBank, 
    including dosage, usage, and interactions—empowering healthcare professionals with instant, reliable insights.
          </p>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container">
      <div class="f-1">
        <h2>MedExtract</h2>
        <p>
          Empowering healthcare through intelligent data. Our platform 
            simplifies clinical narratives, making vital insights easier to access,
             understand, and act upon for better patient care outcomes.
        </p>
      </div>

      <div class="f-2">
        <div>
          <h2>Links</h2>
          <ul class="nav">
            <li><a href="/">Home</a></li>
            <li><a href="/html/guest/guest-about.html">About</a></li>
            <li><a href="/guest-login">Login</a></li>
            <li><a href="/guest-register">Register</a></li>
          </ul>
        </div>
      </div>

      <div class="f-3">
        <h2>Contacts</h2>
        <div class="contacts">
          <div>
            <img src="/flaticons/index/location.png" /> &nbsp;
            <p>
              University of The East Caloocan, 105 Samson Rd, Caloocan, Metro
              Manila
            </p>
          </div>
          <div>
            <img src="/flaticons/index/email.png" /> &nbsp;
            <p>nogot.markvincent@ue.edu.ph</p>
          </div>
          <div>
            <img src="/flaticons/index/call.png" /> &nbsp;
            <p>09991624156</p>
          </div>
        </div>
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('menu-toggle');
    const nav = document.getElementById('guest-nav');
  
    toggle.addEventListener('click', () => {
      nav.classList.toggle('show');
    });
  </script>
  
</body>

</html>